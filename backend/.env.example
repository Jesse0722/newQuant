# 数据源：akshare（默认，推荐）| tushare | composite（多源按顺序回退）
DATA_PROVIDER=akshare
# 组合源顺序（仅 DATA_PROVIDER=composite 时生效），逗号分隔
COMPOSITE_ORDER=akshare,tushare

# Tushare Pro API Token（仅 tushare 或 composite 回退到 tushare 时需要）
TUSHARE_TOKEN=your_tushare_token_here
# Tushare 代理地址 (留空则使用官方 http://api.waditu.com/dataapi)
# 若只填镜像主机如 http://1.2.3.4，程序会自动补全为 http://1.2.3.4/dataapi
# 若镜像挂在自定义路径，请写完整 base，例如 http://host/myapi/dataapi
TUSHARE_API_URL=
# SQLite 数据库路径 (相对于 backend/ 目录)
DATABASE_URL=sqlite:///./data/quant.db
# 数据目录 (相对于 backend/ 目录)
DATA_DIR=./data

# AI 智能选股（可选）
# AI_PROVIDER=openai|qwen|ollama
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
