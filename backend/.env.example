# 数据源：tencent | baostock | akshare | tushare | composite（多源按顺序回退，默认推荐）
DATA_PROVIDER=composite
# 组合源顺序（仅 DATA_PROVIDER=composite 时生效），逗号分隔
COMPOSITE_ORDER=tencent,baostock,akshare

# Tushare Pro API Token（仅 tushare 或 composite 回退到 tushare 时需要）
TUSHARE_TOKEN=your_tushare_token_here
# Tushare API Base URL，可留空使用官方地址。
# 若通过本地/内网代理访问，请填完整 base URL，例如：
# http://127.0.0.1:8080/dataapi
TUSHARE_API_URL=

# SQLite 数据库路径（默认写入 backend/data/）
DATABASE_URL=sqlite:///./data/quant.db
# 数据目录（相对于 backend/ 目录）
DATA_DIR=./data

# 应用启动开关
APP_ENV=development
AUTO_INIT_DB=true
RUN_STARTUP_MIGRATIONS=true
AUTO_START_SCHEDULER=false
SCHEDULER_ENABLED=true

# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# AI 智能选股 / 股票详情 AI 分析（可选）
# AI_PROVIDER=deepseek|openai|qwen|ollama
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# X 舆情采集（可选）
# 需在 X Developer Console 创建 App、购买 credits，并复制 Bearer Token。
# 默认 API base 使用 api.twitter.com；如官方域名策略变化，可通过 X_API_BASE_URL 覆盖。
X_API_BEARER_TOKEN=
X_API_BASE_URL=https://api.twitter.com

# 运行集成测试前请显式导出以下配置：
# TUSHARE_TOKEN=...
# TUSHARE_API_URL=...   # 可选
