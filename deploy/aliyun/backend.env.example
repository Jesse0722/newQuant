APP_ENV=production
DATA_PROVIDER=composite
COMPOSITE_ORDER=tencent,baostock,akshare

DATABASE_URL=sqlite:////app/backend/data/quant.db
DATA_DIR=/app/backend/data

AUTO_INIT_DB=true
RUN_STARTUP_MIGRATIONS=true
AUTO_START_SCHEDULER=false
SCHEDULER_ENABLED=true

CORS_ORIGINS=http://localhost
CORS_ALLOW_CREDENTIALS=true

# Optional providers:
# TUSHARE_TOKEN=
# TUSHARE_API_URL=
# AI_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
